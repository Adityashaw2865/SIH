PORT=4000

# --- Real ABDM Gateway (optional) ---------------------------------------
# Leave all three blank to use the built-in OTP simulation (no NHA
# credentials needed for local dev/demo). Set all three to switch ABHA
# login over to the real ABDM sandbox/production Gateway — see
# src/services/abdmGatewayService.js for how to obtain these.
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_X_CM_ID=sbx

# --- Real Bhashini ASR (optional) ---------------------------------------
# Leave blank to use the built-in offline Whisper ASR (works out of the
# box, no key needed). Set both to route speech-to-text through
# Bhashini/AI4Bharat's Indian-language models instead — see
# src/services/bhashiniService.js. Get a free key at https://bhashini.gov.in
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Secret used to sign/verify staff login JWTs — required (auth.js will crash without it).
# Use any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Set to "true" only for local/demo setup to enable the one-time
# /api/auth/seed-admin route. Leave unset in any real deployment —
# this route creates an unauthenticated admin account.
ALLOW_SEED_ADMIN=

# Frontend origin allowed by CORS. Falls back to http://localhost:5173
# with a startup warning if unset — set explicitly in production.
FRONTEND_URL=

# MongoDB Atlas connection string — required.
# Format: mongodb+srv://<username>:<password>@<cluster-url>/medikiosk?retryWrites=true&w=majority
MONGODB_URI=

# Optional: if set, medical document extraction uses real Google Gemini-based
# clinical entity extraction instead of the rule-based fallback in extractionService.js
GEMINI_API_KEY=